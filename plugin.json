{
	"id": "nodebb-plugin-sso-telegram-oidc",
	"name": "Telegram OIDC SSO",
	"description": "NodeBB Plugin that allows users to login/register via Telegram OpenID Connect (OIDC).",
	"url": "https://github.com/dmytro-filatov-88/nodebb-plugin-sso-telegram-oidc",
	"library": "./library.js",
	"templates": "templates",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:config.get", "method": "filterConfigGet" },
		{ "hook": "filter:auth.list", "method": "filterAuthList" },
		{ "hook": "filter:auth.init", "method": "filterAuthInit" },
		{ "hook": "filter:admin.header.build", "method": "addAdminMenuItem" },
		{ "hook": "static:user.delete", "method": "deleteUserData" },
		{ "hook": "filter:user.whitelistFields", "method": "filterUserWhitelistFields" },
		{ "hook": "filter:user.addToApprovalQueue", "method": "addToApprovalQueue" },
		{ "hook": "filter:user.create", "method": "filterUserCreate" },
		{ "hook": "action:user.create", "method": "actionUserCreate" },
		{ "hook": "filter:user.getRegistrationQueue", "method": "filterUserGetRegistrationQueue" }
	],
	"modules": {
		"../admin/plugins/sso-telegram-oidc.js": "static/lib/admin.js"
	}
}
